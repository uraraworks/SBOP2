# ステージングの設定。staging.env にコピーして値を埋める(staging.env はコミットしない)。

# ステージングのドメイン(DNS の A レコードをこのホストに向けておく)。
# Let's Encrypt の証明書は Caddy が自動で取る。
SBOP2_STAGING_DOMAIN=staging.example.com

# Basic 認証のユーザー名と、パスワードのハッシュ。ハッシュは次で作る:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'パスワード'
SBOP2_BASIC_USER=sbop2
SBOP2_BASIC_HASH=
