{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "mac-debug",
      "displayName": "Mac/Linux Debug",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/cmake-mac",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": ["Darwin", "Linux"]
      }
    },
    {
      "name": "mac-release",
      "displayName": "Mac/Linux Release",
      "inherits": "mac-debug",
      "binaryDir": "${sourceDir}/out/cmake-mac-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "mac-debug", "configurePreset": "mac-debug" },
    { "name": "mac-release", "configurePreset": "mac-release" }
  ],
  "testPresets": [
    { "name": "mac-debug", "configurePreset": "mac-debug", "output": { "outputOnFailure": true } },
    { "name": "mac-release", "configurePreset": "mac-release", "output": { "outputOnFailure": true } }
  ]
}
